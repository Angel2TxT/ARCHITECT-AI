# ARCHITECT
#
# Docker usa su propia DATABASE_URL dentro de docker-compose.yml.
# Para desarrollo local sin Docker, crea la base:
# CREATE DATABASE architect CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://root:TU_PASSWORD@localhost:3306/architect?charset=utf8mb4

# JWT (cambia en produccion)
JWT_SECRET_KEY=genera-un-secreto-largo-y-aleatorio
JWT_EXPIRE_HOURS=168

# Admin inicial (scripts/init_db.py)
ADMIN_EMAIL=admin@architect.local
ADMIN_PASSWORD=admin123

# URL pública (correos, OAuth, Stripe). El checkout demo usa rutas relativas;
# si trabajas en :8000, pon http://localhost:8000 (no :3000 salvo que uses solo el frontend).
APP_BASE_URL=http://127.0.0.1:8000

# Correo — Brevo (https://app.brevo.com → SMTP & API → SMTP)
# Guía paso a paso: docs/MAIL_BREVO_SETUP.md
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=tu_login_brevo@gmail.com
MAIL_PASSWORD=xsmtpsib-tu_clave_smtp
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME=ARCHITECT

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# URI de redirección autorizada: {APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/auth/google/callback

# Opcional
SQL_ECHO=false

# Consultas de construccion sin plano (manuales + internet)
WEB_SEARCH_ENABLED=true

# Prueba sin cuenta (por navegador / cookie)
GUEST_TRIAL_MAX_ANALYSES=1
GUEST_TRIAL_MAX_ASKS=1
GUEST_TRIAL_MAX_FILE_MB=15

# Billing — proyecto escolar: usar demo (pasarela simulada, sin cobros reales).
# BILLING_MODE=demo es el valor recomendado para entrega académica.
BILLING_MODE=demo
BILLING_CHECKOUT_TTL_MINUTES=45

# Opcional (solo producción comercial, NO necesario para proyecto escolar):
# BILLING_MODE=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=mxn

# Conversion DWG (opcional; una opcion basta)
# ODA_CONVERTER_PATH=C:\Program Files\ODA\ODAFileConverter 26.12.0\ODAFileConverter.exe
# LIBREDWG_DWG2DXF=C:\ruta\dwg2dxf.exe
